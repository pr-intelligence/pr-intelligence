generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Installation {
  id            Int          @id @default(autoincrement())
  githubId      BigInt       @unique
  accountLogin  String
  createdAt     DateTime     @default(now())
  repositories  Repository[]

  @@map("installations")
}

model Repository {
  id             Int           @id @default(autoincrement())
  githubId       BigInt        @unique
  installationId Int
  fullName       String
  createdAt      DateTime      @default(now())
  installation   Installation  @relation(fields: [installationId], references: [id])
  pullRequests   PullRequest[]

  @@map("repositories")
}

model PullRequest {
  id           Int        @id @default(autoincrement())
  githubId     BigInt     @unique
  repoId       Int
  number       Int
  title        String
  author       String
  url          String
  state        String
  createdAt    DateTime   @default(now())
  repository   Repository @relation(fields: [repoId], references: [id])
  reviews      Review[]

  @@map("pull_requests")
}

model Review {
  id            Int         @id @default(autoincrement())
  pullRequestId Int
  summary       String
  findings      Json
  provider      String
  commentUrl    String?
  createdAt     DateTime    @default(now())
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id])

  @@map("reviews")
}
